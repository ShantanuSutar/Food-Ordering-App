JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
PORT=9090
DB_URL=jdbc:postgresql://localhost:5432/food_ordering_app
# Alternatively, DATABASE_URL can contain a complete Neon/Render postgres:// URL.
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-database-password
STRIPE_SECRET_KEY=replace-with-your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-your-stripe-webhook-secret
FRONTEND_URL=http://localhost:5173
# Optional comma-separated additional browser origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PAYMENT_CURRENCY=inr
